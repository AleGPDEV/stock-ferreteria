{
  "name": "stock-ferreteria",
  "productName": "Stock Ferretería",
  "version": "1.33.0",
  "description": "Control de stock y caja para ferretería",
  "author": "AleGPDEV",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/logica.test.js tests/herramientas.test.js",
    "test:almacen": "node tests/correr-almacen.js",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:dir": "electron-builder --win dir --x64",
    "herramientas": "node herramientas/armar.js"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "node-gyp": "12.4.0"
  },
  "build": {
    "appId": "uy.alegpdev.stockferreteria",
    "productName": "Stock Ferretería",
    "copyright": "AleGPDEV",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "vendor/**/*",
      "img/**/*",
      "herramientas/*.html",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Stock-Ferreteria-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stock Ferretería",
      "artifactName": "Stock-Ferreteria-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Stock-Ferreteria-Portable-${version}.${ext}"
    },
    "npmRebuild": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ]
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  }
}
